<?xml version="1.0" encoding="UTF-8"?>
<smis>
    <!--Individual measurement file for actionlayer Phase 7 tests: "set B" values. Same
    measurement name as measurements_a.smis (shoulder_length), deliberately DIFFERENT value, so
    a load-then-recompute against this file proves the daemon picked up the change rather than
    coincidentally re-deriving the same geometry.-->
    <version>0.3.4</version>
    <read-only>false</read-only>
    <notes/>
    <unit>cm</unit>
    <pm_system>998</pm_system>
    <personal>
        <family-name/>
        <given-name/>
        <birth-date>1800-01-01</birth-date>
        <gender>unknown</gender>
        <email/>
    </personal>
    <body-measurements>
        <m name="shoulder_length" value="20"/>
    </body-measurements>
</smis>
