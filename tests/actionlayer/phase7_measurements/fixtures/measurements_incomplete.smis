<?xml version="1.0" encoding="UTF-8"?>
<smis>
    <!--Individual measurement file for actionlayer Phase 7 tests: deliberately missing
    "shoulder_length", the one measurement base_pattern.val's A1 point formula requires, to
    exercise the checkRequiredMeasurements()-equivalent error path in
    measurements_sync_handlers.cpp's loadMeasurementsFile().-->
    <version>0.3.4</version>
    <read-only>false</read-only>
    <notes/>
    <unit>cm</unit>
    <pm_system>998</pm_system>
    <personal>
        <family-name/>
        <given-name/>
        <birth-date>1800-01-01</birth-date>
        <gender>unknown</gender>
        <email/>
    </personal>
    <body-measurements>
        <m name="hip_circ" value="101"/>
    </body-measurements>
</smis>
