<?xml version="1.0" encoding="UTF-8"?>
<smis>
    <!--Measurements created for actionlayer Phase 5 tests. No individual measurements are
    defined: every script in this test folder uses only literal x/y coordinates, so no formula
    ever needs to look one up.-->
    <version>0.3.4</version>
    <read-only>false</read-only>
    <notes/>
    <unit>mm</unit>
    <pm_system>998</pm_system>
    <personal>
        <family-name/>
        <given-name/>
        <birth-date>1800-01-01</birth-date>
        <gender>unknown</gender>
        <email/>
    </personal>
    <body-measurements/>
</smis>
