<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <!--Pattern created with Seamly2D v0.6.0.1 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>mm</unit>
    <description/>
    <notes/>
    <measurements/>
    <variables/>
    <!--The current pattern schema requires draftBlock+ (at least one draft block), even in an
    otherwise empty file. VPattern::CreateEmptyFile() builds a truly zero draftBlock DOM in
    memory, but that in-memory state is never itself round tripped through XSD validation before
    the GUI's first VToolBasePoint::Create() call adds one. This placeholder satisfies that
    schema minimum without colliding with any name a Phase 5 test script creates via "basePoint"
    (which all use "Front"/"Back"/"Side"), so every basePoint action below is still exercising
    real "create a brand new draft block" behavior, not "reuse an existing empty one".-->
    <draftBlock name="_seed">
        <calculation/>
        <modeling/>
        <pieces/>
        <groups/>
        <images/>
    </draftBlock>
    <draftBlock name="Front">
        <calculation>
            <point id="1" mx="0" my="0" name="A" showPointName="true" type="single" x="0" y="0"/>
            <point angle="0" basePoint="1" id="2" length="200" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="B" showPointName="true" type="endLine"/>
            <point angle="90" basePoint="2" id="3" length="140" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="C" showPointName="true" type="endLine"/>
            <point angle="180" basePoint="3" id="4" length="60" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="D" showPointName="true" type="endLine"/>
            <point angle="90" basePoint="4" id="5" length="60" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="E" showPointName="true" type="endLine"/>
            <point angle="90" basePoint="1" id="6" length="200" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="F" showPointName="true" type="endLine"/>
            <line firstPoint="1" id="7" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="2"/>
            <line firstPoint="2" id="8" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="3"/>
            <line firstPoint="3" id="9" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="4"/>
            <line firstPoint="4" id="10" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="5"/>
            <line firstPoint="5" id="11" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="6"/>
            <line firstPoint="6" id="12" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="1"/>
        </calculation>
        <modeling>
            <point id="13" idObject="1" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="14" idObject="2" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="15" idObject="3" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="16" idObject="4" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="17" idObject="5" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="18" idObject="6" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
        </modeling>
        <pieces>
            <piece color="white" fill="nobrush" forbidFlipping="false" hideMainPath="false" id="19" inLayout="true" locked="false" mx="0" my="0" name="LShape" seamAllowance="true" united="false" version="2" width="10">
                <data annotation="" foldPosition="" fontSize="0" height="" letter="" mx="0" my="0" onFold="false" orientation="" quantity="1" rotation="" rotationWay="" tilt="" visible="false" width=""/>
                <patternInfo fontSize="0" height="" mx="0" my="0" rotation="" visible="false" width=""/>
                <grainline arrowLength="" arrows="0" length="" mx="0" my="0" rotation="" visible="false"/>
                <nodes>
                    <node idObject="13" type="NodePoint"/>
                    <node idObject="14" type="NodePoint"/>
                    <node idObject="15" type="NodePoint"/>
                    <node idObject="16" type="NodePoint"/>
                    <node idObject="17" type="NodePoint"/>
                    <node idObject="18" type="NodePoint"/>
                </nodes>
            </piece>
        </pieces>
        <groups/>
        <images/>
    </draftBlock>
</pattern>
