<?xml version="1.0" encoding="UTF-8"?>
<smis>
    <!--Minimal measurement file reused across every Phase 8 tests/actionlayer/cases/ scenario.
    No individual measurements are defined: every case in cases/ uses only literal formulas (mm
    values, e.g. "200"), so no formula ever needs to look one up. Mirrors
    fixtures/empty_measurements.smis (Phase 5) exactly; kept as a separate file under the name
    Part B of the Phase 8 task asked for, so the cases/ harness does not depend on file names
    owned by an earlier phase's own test folder.-->
    <version>0.3.4</version>
    <read-only>false</read-only>
    <notes/>
    <unit>mm</unit>
    <pm_system>998</pm_system>
    <personal>
        <family-name/>
        <given-name/>
        <birth-date>1800-01-01</birth-date>
        <gender>unknown</gender>
        <email/>
    </personal>
    <body-measurements/>
</smis>
