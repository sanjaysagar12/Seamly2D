<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <!--Pattern created with Seamly2D v0.6.0.1 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>mm</unit>
    <description/>
    <notes/>
    <measurements/>
    <variables/>
    <!--The current pattern schema requires draftBlock+ (at least one draft block), even in an
    otherwise empty file. VPattern::CreateEmptyFile() builds a truly zero draftBlock DOM in
    memory, but that in-memory state is never itself round tripped through XSD validation before
    the GUI's first VToolBasePoint::Create() call adds one. This placeholder satisfies that
    schema minimum without colliding with any name a Phase 5 test script creates via "basePoint"
    (which all use "Front"/"Back"/"Side"), so every basePoint action below is still exercising
    real "create a brand new draft block" behavior, not "reuse an existing empty one".-->
    <draftBlock name="_seed">
        <calculation/>
        <modeling/>
        <pieces/>
        <groups/>
        <images/>
    </draftBlock>
    <draftBlock name="Front">
        <calculation>
            <point id="1" mx="0" my="0" name="A" showPointName="true" type="single" x="0" y="0"/>
            <point angle="0" basePoint="1" id="2" length="20" lineColor="black" lineType="hair" lineWeight="0.35" mx="0" my="0" name="A1" showPointName="true" type="endLine"/>
            <point angle="-70" basePoint="1" id="3" length="20" lineColor="black" lineType="hair" lineWeight="0.35" mx="0" my="0" name="A2" showPointName="true" type="endLine"/>
            <line firstPoint="1" id="4" lineColor="black" lineType="hair" lineWeight="0.35" secondPoint="2"/>
            <line firstPoint="1" id="5" lineColor="black" lineType="hair" lineWeight="0.35" secondPoint="3"/>
            <point id="6" length="shoulder_length" lineColor="black" lineType="none" lineWeight="0.35" mx="0" my="0" name="Sh1" p1Line="1" p2Line="3" pShoulder="2" showPointName="true" type="shoulder"/>
        </calculation>
        <modeling/>
        <pieces/>
        <groups/>
        <images/>
    </draftBlock>
</pattern>
