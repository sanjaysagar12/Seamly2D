<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <!--Pattern created with Seamly2D v0.6.0.1 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>mm</unit>
    <description/>
    <notes/>
    <measurements>measurements.smis</measurements>
    <variables/>
    <!--The current pattern schema requires draftBlock+ (at least one draft block), even in an
    otherwise empty file. VPattern::CreateEmptyFile() builds a truly zero draftBlock DOM in
    memory, but that in-memory state is never itself round tripped through XSD validation before
    the GUI's first VToolBasePoint::Create() call adds one. This placeholder satisfies that
    schema minimum without colliding with any name a Phase 5 test script creates via "basePoint"
    (which all use "Front"/"Back"/"Side"), so every basePoint action below is still exercising
    real "create a brand new draft block" behavior, not "reuse an existing empty one".-->
    <draftBlock name="_seed">
        <calculation/>
        <modeling/>
        <pieces/>
        <groups/>
        <images/>
    </draftBlock>
    <draftBlock name="Front">
        <calculation>
            <point id="1" mx="0" my="0" name="A" showPointName="true" type="single" x="0" y="0"/>
            <point angle="-90" basePoint="1" id="2" length="neck_circ/6+15" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="A1" showPointName="true" type="endLine"/>
            <point angle="0" basePoint="1" id="3" length="neck_circ/6" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="A2" showPointName="true" type="endLine"/>
            <point angle="-20" basePoint="3" id="4" length="shoulder_length" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="A3" showPointName="true" type="endLine"/>
            <point angle="0" basePoint="1" id="5" length="bust_circ/4+20" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="A4h" showPointName="true" type="endLine"/>
            <point angle="-90" basePoint="5" id="6" length="shoulder_tip_to_armfold_f" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="A4" showPointName="true" type="endLine"/>
            <point angle="-90" basePoint="6" id="7" length="neck_side_to_waist_f-shoulder_tip_to_armfold_f" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="A5" showPointName="true" type="endLine"/>
            <point angle="-90" basePoint="1" id="8" length="neck_side_to_waist_f" lineColor="black" lineType="solidLine" lineWeight="0.35" mx="0" my="0" name="A6" showPointName="true" type="endLine"/>
            <line firstPoint="3" id="9" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="4"/>
            <line firstPoint="6" id="10" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="7"/>
            <line firstPoint="7" id="11" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="8"/>
            <line firstPoint="8" id="12" lineColor="black" lineType="solidLine" lineWeight="0.35" secondPoint="2"/>
            <spline angle1="0" angle2="250" color="black" id="13" length1="35" length2="20" lineWeight="0.35" penStyle="solidLine" point1="2" point4="3" type="simpleInteractive"/>
            <spline angle1="-110" angle2="-90" color="black" id="14" length1="70" length2="60" lineWeight="0.35" penStyle="solidLine" point1="4" point4="6" type="simpleInteractive"/>
        </calculation>
        <modeling>
            <point id="15" idObject="2" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="16" idObject="3" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="17" idObject="4" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="18" idObject="6" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="19" idObject="7" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
            <point id="20" idObject="8" inUse="true" mx="0" my="0" showPointName="true" type="modeling"/>
        </modeling>
        <pieces>
            <piece color="white" fill="nobrush" forbidFlipping="false" hideMainPath="false" id="21" inLayout="true" locked="false" mx="0" my="0" name="Front" seamAllowance="true" united="false" version="2" width="10">
                <data annotation="" foldPosition="" fontSize="0" height="" letter="" mx="0" my="0" onFold="false" orientation="" quantity="1" rotation="" rotationWay="" tilt="" visible="false" width=""/>
                <patternInfo fontSize="0" height="" mx="0" my="0" rotation="" visible="false" width=""/>
                <grainline arrowLength="" arrows="0" length="" mx="0" my="0" rotation="" visible="false"/>
                <nodes>
                    <node idObject="15" type="NodePoint"/>
                    <node idObject="16" type="NodePoint"/>
                    <node idObject="17" type="NodePoint"/>
                    <node idObject="18" type="NodePoint"/>
                    <node idObject="19" type="NodePoint"/>
                    <node idObject="20" type="NodePoint"/>
                </nodes>
            </piece>
        </pieces>
        <groups/>
        <images/>
    </draftBlock>
</pattern>
